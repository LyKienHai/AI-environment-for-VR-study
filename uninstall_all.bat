@echo off
title Uninstall — GenAI VR Project (Full Cleanup)
color 0C
echo.
echo  ============================================================
echo    FULL UNINSTALL — GenAI 3D VR Language Learning
echo    This will remove ALL AI packages, models, and data.
echo  ============================================================
echo.
echo  Press any key to start, or close this window to cancel.
pause >nul

REM ── Detect Python ────────────────────────────────────────────────────────────
set PY=
if exist "E:\Python\python.exe"     set PY=E:\Python\python.exe
if exist "C:\Python311\python.exe"  set PY=C:\Python311\python.exe
if "%PY%"=="" (
    where python >nul 2>&1 && set PY=python
)
if "%PY%"=="" (
    echo  [WARN] Python not found — skipping pip uninstalls.
    goto :delete_models
)

echo.
echo  [1/6] Uninstalling AI and web packages...
"%PY%" -m pip uninstall -y ^
    torch torchvision torchaudio ^
    diffusers transformers accelerate ^
    openai-whisper ^
    gradio ^
    fastapi uvicorn python-multipart ^
    requests pillow numpy scipy ^
    huggingface-hub tokenizers safetensors ^
    xformers triton ^
    matplotlib ^
    > uninstall_log.txt 2>&1
echo  Done.

echo.
echo  [2/6] Clearing pip cache...
"%PY%" -m pip cache purge >> uninstall_log.txt 2>&1
echo  Done.

:delete_models
echo.
echo  [3/6] Deleting downloaded AI models...

REM Whisper models (stored in user cache)
set WHISPER_CACHE=%USERPROFILE%\.cache\whisper
if exist "%WHISPER_CACHE%" (
    rmdir /s /q "%WHISPER_CACHE%"
    echo  Removed Whisper model cache: %WHISPER_CACHE%
) else (
    echo  Whisper cache not found — skipping.
)

REM HuggingFace models (Stable Diffusion, transformers, etc.)
set HF_CACHE=%USERPROFILE%\.cache\huggingface
if exist "%HF_CACHE%" (
    rmdir /s /q "%HF_CACHE%"
    echo  Removed HuggingFace model cache: %HF_CACHE%
) else (
    echo  HuggingFace cache not found — skipping.
)

REM Torch hub cache
set TORCH_CACHE=%USERPROFILE%\.cache\torch
if exist "%TORCH_CACHE%" (
    rmdir /s /q "%TORCH_CACHE%"
    echo  Removed Torch hub cache: %TORCH_CACHE%
) else (
    echo  Torch cache not found — skipping.
)

REM Local AI output files
set AI_OUT=E:\ai_generator\output
if exist "%AI_OUT%" (
    rmdir /s /q "%AI_OUT%"
    echo  Removed AI output folder: %AI_OUT%
)

echo.
echo  [4/6] Removing generated NPC sprites and assets...
if exist "C:\GenAI-3D-Virtual-Reality-Augmented\assets" (
    rmdir /s /q "C:\GenAI-3D-Virtual-Reality-Augmented\assets"
    echo  Removed assets folder.
)

echo.
echo  [5/6] Removing Unity Library and Temp (auto-generated, safe to delete)...
set UNITY_PROJ=E:\AI_HDRI_Unity
if exist "%UNITY_PROJ%\Library" (
    rmdir /s /q "%UNITY_PROJ%\Library"
    echo  Removed Unity Library cache.
)
if exist "%UNITY_PROJ%\Temp" (
    rmdir /s /q "%UNITY_PROJ%\Temp"
    echo  Removed Unity Temp folder.
)

echo.
echo  [6/6] Removing generated AI object scripts from Unity Assets...
REM Remove any auto-generated .cs files from our Room AI
set UA=E:\AI_HDRI_Unity\Assets
for %%f in ("%UA%\*.cs") do (
    findstr /m "auto-generated by Room AI" "%%f" >nul 2>&1
    if not errorlevel 1 (
        del /f /q "%%f"
        echo  Deleted: %%~nxf
    )
)

echo.
echo  ============================================================
echo    Uninstall complete!
echo.
echo    What was removed:
echo      - torch, diffusers, transformers, whisper, gradio, etc.
echo      - Whisper model cache (~74-769 MB)
echo      - HuggingFace / Stable Diffusion model cache
echo      - PyTorch hub cache
echo      - AI-generated room object scripts
echo      - Unity Library and Temp cache
echo.
echo    What was KEPT (your files, untouched):
echo      - C:\GenAI-3D-Virtual-Reality-Augmented\ (all .py, .cs source)
echo      - E:\AI_HDRI_Unity\ (Unity project source)
echo      - GitHub repository
echo      - Python itself (only packages removed)
echo.
echo    See uninstall_log.txt for full pip output.
echo  ============================================================
echo.
pause
